# --- Apify (grabs new posts from Polymarket's Instagram) ---
APIFY_API_TOKEN=your_apify_token_here
APIFY_ACTOR=apify~instagram-scraper
INSTAGRAM_SOURCE_URL=https://www.instagram.com/polymarketsport/

# --- Post Bridge ---
POST_BRIDGE_API_KEY=pb_live_xxxxxxxxxxxx
POST_BRIDGE_TIKTOK_ACCOUNT_ID=your_polycool_tiktok_account_id
POST_BRIDGE_YOUTUBE_ACCOUNT_ID=your_polycool_youtube_account_id

# --- How often to auto-check for new videos (minutes) ---
CHECK_INTERVAL_MINUTES=20

# --- Logo cover-box + overlay position (pixels) â€” tweak after your first test run ---
LOGO_COVER_X=16
LOGO_COVER_Y=16
LOGO_COVER_W=280
LOGO_COVER_H=72
LOGO_OVERLAY_X=20
LOGO_OVERLAY_Y=20

# Railway sets PORT automatically â€” leave this as a fallback for local testing
PORT=3000
