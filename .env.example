# Template only — copy real values into Railway's environment variable settings.
# NEVER fill in real values here and commit this file. See CLAUDE.md security section.

# --- Apify (grabs new posts from Polymarket's Instagram) ---
APIFY_API_TOKEN=your_apify_token_here
APIFY_ACTOR=apify~instagram-scraper
INSTAGRAM_SOURCE_URL=https://www.instagram.com/polymarket/

# --- Post Bridge ---
POST_BRIDGE_API_KEY=pb_live_your_key_here
POST_BRIDGE_TIKTOK_ACCOUNT_ID=your_polycool_tiktok_account_id
POST_BRIDGE_YOUTUBE_ACCOUNT_ID=your_polycool_youtube_account_id

# --- How often to auto-check for new videos (minutes) ---
CHECK_INTERVAL_MINUTES=20

# --- Never process/post anything from before this date, no matter what Apify returns ---
PROCESS_SINCE_DATE=2026-08-03T00:00:00Z

# --- Required to approve/reject anything in the dashboard's Pending Review queue ---
# Pick your own password — this is not a real value, just a placeholder.
APPROVAL_PASSWORD=choose_your_own_password

# --- Just a starting rectangle for the dashboard's box editor (pixels) ---
# You draw the real cover box by hand on each video now (Polymarket's layout keeps
# changing), these only prefill the box before you drag — safe to leave as-is.
LOGO_COVER_X=16
LOGO_COVER_Y=16
LOGO_COVER_W=280
LOGO_COVER_H=72

# Railway sets PORT automatically — leave this as a fallback for local testing
PORT=3000
